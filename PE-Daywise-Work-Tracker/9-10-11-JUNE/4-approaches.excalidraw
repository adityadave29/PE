      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After pull-up, the view is treated as \npart of the parent query, \nallowing PostgreSQL to perform optimizations \non the entire query as a single unit.",
      "autoResize": true,
      "lineHeight": 1.25
    },
