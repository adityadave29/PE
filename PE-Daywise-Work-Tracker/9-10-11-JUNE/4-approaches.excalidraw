    {
      "id": "UHnoM8WhA4jd8uXr6K6PU",
      "type": "text",
      "x": 4248.510056196976,
      "y": 775.0685891388645,
      "width": 1251.4674072265625,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1P",
      "roundness": null,
      "seed": 932508339,
      "version": 81,
      "versionNonce": 954099671,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1781078266440,
      "link": null,
      "locked": false,
      "text": "if (!ignore_security &&\n                (procedureStruct->prosecdef ||\n                 !heap_attisnull(procedureTuple, Anum_pg_proc_proconfig, NULL) ||\n                 FmgrHookIsNeeded(functionId)))\n        {\n                finfo->fn_addr = fmgr_security_definer;\n                finfo->fn_stats = TRACK_FUNC_ALL;        /* ie, never track */\n                finfo->fn_oid = functionId;\n                ReleaseSysCache(procedureTuple);\n                return;\n        }",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if (!ignore_security &&\n                (procedureStruct->prosecdef ||\n                 !heap_attisnull(procedureTuple, Anum_pg_proc_proconfig, NULL) ||\n                 FmgrHookIsNeeded(functionId)))\n        {\n                finfo->fn_addr = fmgr_security_definer;\n                finfo->fn_stats = TRACK_FUNC_ALL;        /* ie, never track */\n                finfo->fn_oid = functionId;\n                ReleaseSysCache(procedureTuple);\n                return;\n        }",
      "autoResize": true,
      "lineHeight": 1.25
    },
